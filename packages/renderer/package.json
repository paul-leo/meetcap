{
  "name": "meetcap-renderer",
  "version": "0.2.0",
  "description": "Renderer-process half of meetcap: detector client + mic & system (loopback) audio capture, mix, record to webm, save. Framework-agnostic + React/Vue hooks. Electron.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./react": {
      "types": "./dist/cjs/react.d.ts",
      "import": "./dist/esm/react.js",
      "require": "./dist/cjs/react.js",
      "default": "./dist/cjs/react.js"
    },
    "./vue": {
      "types": "./dist/cjs/vue.d.ts",
      "import": "./dist/esm/vue.js",
      "require": "./dist/cjs/vue.js",
      "default": "./dist/cjs/vue.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node ../../scripts/write-dual-pkg.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paul-leo/meetcap.git",
    "directory": "packages/renderer"
  },
  "keywords": [
    "electron",
    "zoom",
    "meeting",
    "detection",
    "audio",
    "recorder",
    "loopback",
    "mediarecorder",
    "react",
    "vue",
    "meetcap"
  ],
  "dependencies": {
    "meetcap-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=17",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "react": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "vue": "^3.5.13"
  }
}
