{
  "name": "web-demo",
  "version": "0.1.0",
  "private": true,
  "description": "meetcap-web demo — browser-only recording: test tone (zero permissions), mic, shared tab/screen, IndexedDB library with crash-resume.",
  "scripts": {
    "start": "esbuild src/app.ts --bundle --outfile=www/bundle.js --platform=browser --format=iife --sourcemap --define:__HARNESS_ENABLED__=true --servedir=www --serve=127.0.0.1:8047",
    "build": "esbuild src/app.ts --bundle --outfile=www/bundle.js --platform=browser --format=iife --define:__HARNESS_ENABLED__=false",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "meetcap-core": "workspace:*",
    "meetcap-web": "workspace:*"
  },
  "devDependencies": {
    "@harness-fe/runtime": "^4.3.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
