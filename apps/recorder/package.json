{
  "name": "meetcap-recorder",
  "version": "0.1.0",
  "private": true,
  "description": "meetcap Recorder — menu-bar screen/meeting recorder: screen + system audio + mic (+ camera), meeting auto-detection, crash-safe local library. The desktop enhancer for meetcap-web pages (agent mode, Phase 3).",
  "main": "main.js",
  "scripts": {
    "build": "esbuild renderer/bar.ts renderer/library.ts --bundle --outdir=renderer --platform=browser --format=iife --sourcemap --define:__HARNESS_ENABLED__=true",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "build:dist": "esbuild renderer/bar.ts renderer/library.ts --bundle --outdir=renderer --platform=browser --format=iife --define:__HARNESS_ENABLED__=false"
  },
  "dependencies": {
    "meetcap-core": "workspace:*",
    "meetcap-main": "workspace:*",
    "meetcap-renderer": "workspace:*"
  },
  "devDependencies": {
    "electron": "^38.2.2",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "@harness-fe/runtime": "^4.3.1"
  }
}
